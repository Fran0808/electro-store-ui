<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.inventario.GuiaDetailController">
    <stylesheets>
        <URL value="@../../styles/style.css" />
    </stylesheets>
    <children>
        <VBox spacing="16.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
            
            <VBox spacing="12.0" styleClass="form-section">
                <HBox spacing="20.0" alignment="CENTER_LEFT">
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Código de Guía" />
                        <Label fx:id="lblCodigo" style="-fx-font-size:16px; -fx-font-weight:bold;" text="GU-000001" />
                    </VBox>
                    
                    <Separator orientation="VERTICAL" />
                    
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Tipo" />
                        <HBox spacing="8.0">
                            <Label fx:id="lblTipo" style="-fx-font-size:13px; -fx-font-weight:bold;" text="Entrada" />
                            <Label fx:id="lblBadgeTipo" style="-fx-padding: 2 8; -fx-background-color: #10b98140; -fx-text-fill: #059669; -fx-border-radius: 4; -fx-padding: 4 8; -fx-font-size: 11px;" text="ENTRY" />
                        </HBox>
                    </VBox>
                    
                    <Separator orientation="VERTICAL" />
                    
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Fecha y Hora" />
                        <Label fx:id="lblFechaHora" style="-fx-font-size:13px; -fx-font-weight:bold;" text="20/11/2024 14:30:45" />
                    </VBox>
                </HBox>
                
                <Separator />
                
                <HBox spacing="20.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Motivo" />
                        <Label fx:id="lblMotivo" style="-fx-font-size:12px;" text="Conteo físico de almacén" />
                    </VBox>
                    <VBox spacing="4.0" minWidth="150.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Usuario" />
                        <Label fx:id="lblUsuario" style="-fx-font-size:12px;" text="Carlos Mendoza" />
                    </VBox>
                </HBox>
                
                <VBox spacing="4.0">
                    <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Descripción" />
                    <Label fx:id="lblDescripcion" style="-fx-font-size:12px;" text="Ajuste por diferencias encontradas en sección electrónica. Se corrigió stock de mouse inalámbrico." wrapText="true" />
                </VBox>
            </VBox>
            
            <Separator />
 
            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size:13px; -fx-font-weight:bold;" text="Productos Movidos" />
                
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" styleClass="products-table">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="100" text="Código" />
                        <TableColumn fx:id="colProducto" prefWidth="350" text="Producto" />
                        <TableColumn fx:id="colCantidad" prefWidth="100" text="Cantidad" style="-fx-alignment: CENTER;" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                
                <HBox alignment="CENTER_RIGHT" spacing="40.0" style="-fx-padding: 12; -fx-border-width: 1 0 0 0; -fx-border-color: #ddd;">
                    <VBox spacing="4.0" alignment="CENTER_RIGHT">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Total productos distintos:" />
                        <Label fx:id="lblTotalProductos" style="-fx-font-size:14px; -fx-font-weight:bold;" text="0" />
                    </VBox>
                    <VBox spacing="4.0" alignment="CENTER_RIGHT">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Total unidades movidas:" />
                        <Label fx:id="lblTotalUnidades" style="-fx-font-size:14px; -fx-font-weight:bold;" text="0" />
                    </VBox>
                </HBox>
            </VBox>
            
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button fx:id="btnExportar" styleClass="btn-secondary" text="Exportar" onAction="#handleExportar"/>
                <Button fx:id="btnCerrar" onAction="#handleCerrar" styleClass="btn-primary" text="Cerrar" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
