<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.inventario.guias.GuiaFormController">
    <stylesheets>
        <URL value="@../../../styles/style.css" />
    </stylesheets>
    <children>
        <VBox spacing="18.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
            <Label style="-fx-font-size:16px; -fx-font-weight:bold;" text="Nueva Guía de Inventario" />
            <VBox spacing="12.0" styleClass="form-section">
                <Label style="-fx-font-size:13px; -fx-font-weight:bold;" text="Datos del Documento" />
                
                <HBox spacing="20.0">
                    <VBox minWidth="250.0" prefWidth="250.0" spacing="8.0">
                        <Label text="Tipo *" />
                        <HBox spacing="15.0">
                            <RadioButton fx:id="rbEntry" text="Entrada">
                        <toggleGroup>
                           <ToggleGroup fx:id="tipoGroup" />
                        </toggleGroup></RadioButton>
                            <RadioButton fx:id="rbExit" text="Salida" toggleGroup="$tipoGroup" />
                        </HBox>
                    </VBox>

                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Usuario" />
                        <TextField fx:id="txtUsuario" editable="false" prefHeight="23.0" prefWidth="255.0" styleClass="disabled-field" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Motivo *" />
                        <TextField fx:id="txtMotivo" prefHeight="36.0" promptText="Ej: Conteo físico, Merma, Devolución..." />
                    </VBox>
                </HBox>
                
                <VBox spacing="8.0">
                    <Label text="Descripción (opcional)" />
                    <TextField fx:id="txtDescripcion" promptText="Detalles adicionales del ajuste..." />
                </VBox>
            </VBox>

            <Separator />

            <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size:13px; -fx-font-weight:bold;" text="Detalle de Productos *" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox minWidth="100.0" spacing="2.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Buscar y seleccionar" />
                        <ComboBox fx:id="cbProducto" prefWidth="350.0" styleClass="filter-combo" HBox.hgrow="ALWAYS" />
                    </VBox>
                    <VBox minWidth="100.0" spacing="2.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Stock actual" />
                        <TextField fx:id="txtStockActual" editable="false" prefHeight="32.0" style="-fx-font-size:11px;" styleClass="disabled-field" />
                    </VBox>
                    <VBox minWidth="100.0" spacing="2.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Cantidad" />
                        <Spinner fx:id="spnCantidad" prefHeight="32.0" prefWidth="100.0" styleClass="filter-combo" />
                    </VBox>
                    <Button fx:id="btnAgregarProducto" onAction="#handleAgregarProducto" styleClass="btn-primary" text="Agregar" />
                </HBox>

                <TableView fx:id="tblDetalle" styleClass="products-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCod" prefWidth="100" text="Código" />
                        <TableColumn fx:id="colProducto" prefWidth="300" text="Producto" />
                        <TableColumn fx:id="colCantidad" prefWidth="100" style="-fx-alignment: CENTER;" text="Cantidad" />
                        <TableColumn fx:id="colAcciones" prefWidth="120" style="-fx-alignment: CENTER;" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="40.0" style="-fx-padding: 12; -fx-border-width: 1 0 0 0; -fx-border-color: #ddd;">
                    <VBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Total productos:" />
                        <Label fx:id="lblTotalProductos" style="-fx-font-size:14px; -fx-font-weight:bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Total unidades:" />
                        <Label fx:id="lblTotalUnidades" style="-fx-font-size:14px; -fx-font-weight:bold;" text="0" />
                    </VBox>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button fx:id="btnCancelar" onAction="#handleCancelar" styleClass="btn-secondary" text="Cancelar" />
                <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="btn-primary" text="Guardar Guía" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
