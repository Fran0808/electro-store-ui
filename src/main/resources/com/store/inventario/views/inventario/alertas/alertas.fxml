<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.inventario.alertas.AlertaController">
    <stylesheets>
        <URL value="@../../../styles/style.css" />
    </stylesheets>
    <VBox spacing="20" styleClass="view-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox prefHeight="32.0" prefWidth="580.0" spacing="4">
                <Label styleClass="header-title" text="Alertas de Inventario" />
                <Label styleClass="header-subtitle" text="Productos con stock bajo el umbral configurado" />
            </VBox>
           <HBox alignment="CENTER_RIGHT" prefHeight="41.0" prefWidth="798.0" spacing="12">
            <children>
                  <Button fx:id="btnConfigLimite" styleClass="btn-primary" text="Configurar Límite" onAction="#handleForm"/>
            </children>
           </HBox>
        </HBox>
        

<TableView fx:id="tblAlertas" styleClass="products-table" VBox.vgrow="ALWAYS">
    <columns>
        <TableColumn fx:id="colCodigo" prefWidth="100" text="Código" />
        <TableColumn fx:id="colProveedor" prefWidth="150" text="Proveedor" />
        <TableColumn fx:id="colProducto" prefWidth="200" text="Producto" />
        <TableColumn fx:id="colStock" prefWidth="100" text="Stock" />
        <TableColumn fx:id="colLimite" prefWidth="120" text="Límite de Stock" />
        <TableColumn fx:id="colPrioridad" prefWidth="120" text="Prioridad" />
        <TableColumn fx:id="colEstado" prefWidth="120" text="Estado" />
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
</TableView>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="pagination-container">
    <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Mostrando 1-20 de 0 alertas" HBox.hgrow="ALWAYS" />
    <HBox alignment="CENTER_RIGHT" spacing="8">
        <Button fx:id="btnAnterior" styleClass="btn-secondary" text="Anterior" />
        <Button fx:id="btnSiguiente" styleClass="btn-secondary" text="Siguiente" />
    </HBox>

</HBox>        

    </VBox>
</AnchorPane>
