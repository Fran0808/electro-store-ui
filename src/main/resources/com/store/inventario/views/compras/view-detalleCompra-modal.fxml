<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="980.0" styleClass="root" stylesheets="@../../styles/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox spacing="24.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <padding>
                <Insets bottom="28" left="28" right="28" top="28" />
            </padding>

            <VBox spacing="6">
                <Label styleClass="header-title" text="Ver Detalle de Compra " />
                <Label styleClass="header-subtitle" text="Consulta la trazabilidad y documentos asociados a esta transacción" />
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="CÓDIGO DE COMPRA" />
                    <Label styleClass="metric-label" text="#CP-2025-001" />
                </VBox>
                <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="FECHA" />
                    <Label styleClass="metric-label" text="24 Oct, 2025 - 14:30" />
                </VBox>
                <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="PROVEEDOR" />
                    <Label styleClass="metric-label" text="Logística Global S.A.C." />
                </VBox>
                <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="RESPONSABLE" />
                    <Label styleClass="metric-label" text="Marcos Valdivia" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label styleClass="metric-label" text="Productos Comprados" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="header-subtitle" text="Items: --" />
            </HBox>

            <TableView fx:id="tblDetalleCompra" prefHeight="280" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="595.0" text="Producto" />
                    <TableColumn text="cantidad" />
                    <TableColumn prefWidth="131.0" text="Precio Unitario" />
                    <TableColumn prefWidth="117.0" text="subtotal" />
                </columns>
            </TableView>

            <HBox alignment="TOP_CENTER" spacing="20">
                <VBox prefHeight="171.0" prefWidth="415.0" spacing="10" styleClass="metric-card">
                    <Label styleClass="metric-label" text="Código de guía: " />
                    <Separator />
                    <HBox spacing="10">
                        <Label styleClass="header-subtitle" text="Descripcióm:" />
                        <Label styleClass="metric-value" text="-----------" />
                    </HBox>
                </VBox>

                <VBox prefHeight="171.0" prefWidth="422.0" spacing="14" style="-fx-background-color: #0F172A; -fx-background-radius: 8; -fx-padding: 24;">
                    <HBox>
                        <Label style="-fx-text-fill: #CBD5E1; -fx-font-size: 13px;" text="Subtotal de Compra:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="S/ 54,400.00" />
                    </HBox>
                    <HBox>
                        <Label style="-fx-text-fill: #CBD5E1; -fx-font-size: 13px;" text="Impuestos (IGV 18%):" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="S/ 9,792.00" />
                    </HBox>
                    <Separator style="-fx-background-color: #334155;" />
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="TOTAL FINAL:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="S/ 64,192.00" />
                    </HBox>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#cerrarModal" styleClass="btn-secondary" text="Cerrar" />
                <Button styleClass="btn-primary" text="Imprimir Guía" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
