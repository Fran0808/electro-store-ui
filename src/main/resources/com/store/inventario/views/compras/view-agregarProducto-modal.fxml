<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" styleClass="root" stylesheets="@../../styles/style.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.inventario.controller.compra.CompraFormController">

    <VBox spacing="24.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="28" left="28" right="28" top="28"/>
        </padding>

        <VBox spacing="6">
            <Label styleClass="header-title" text="Seleccionar Productos"/>
            <Label styleClass="header-subtitle" text="Busca y selecciona los productos para agregarlos a la compra"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="txtBuscarProducto" promptText="Buscar producto..." styleClass="search-field"
                       HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cbProveedor" promptText="Proveedor" styleClass="filter-combo"/>
            <ComboBox fx:id="cbMarca" promptText="Marca" styleClass="filter-combo"/>
            <ComboBox fx:id="cbCategoria" promptText="Categoría" styleClass="filter-combo"/>
            <ComboBox fx:id="cbModelo" promptText="Modelo" styleClass="filter-combo"/>
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label styleClass="metric-label" text="PRODUCTOS DISPONIBLES"/>
                <TableView fx:id="tblProductos" prefHeight="350" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn prefWidth="224.0" text="Producto"/>
                        <TableColumn prefWidth="76.0" text="Stock"/>
                        <TableColumn prefWidth="83.0" text="Agregar"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label styleClass="metric-label" text="Productos Seleccionados"/>
                <TableView fx:id="tblProductosSeleccionados" prefHeight="350" styleClass="table-view"
                           VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn prefWidth="289.0" text="Producto"/>
                        <TableColumn text="Cantidad"/>
                        <TableColumn prefWidth="94.0" text="Precio"/>
                        <TableColumn prefWidth="77.0" text="Eliminar"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Button fx:id="btnCancelar" onAction="#cerrarModal" styleClass="btn-secondary" text="Cancelar"/>
            <Button maxWidth="Infinity" styleClass="btn-secondary" text="Registrar"/>
        </HBox>
    </VBox>
</AnchorPane>
