<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.store.inventario.controller.compra.CompraFormController"
        stylesheets="@../../styles/style.css"
        prefHeight="650.0"
        prefWidth="1000.0"
        styleClass="root">

    <children>
        <VBox spacing="24.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">

            <padding>
                <Insets top="28" right="28" left="28" bottom="28"/>
            </padding>

            <VBox spacing="6">
                <Label text="Seleccionar Productos" styleClass="header-title"/>
                <Label text="Busca y selecciona los productos para agregarlos a la compra" styleClass="header-subtitle"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscarProducto" promptText="Buscar producto..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cbProveedor" promptText="Proveedor" styleClass="filter-combo"/>
                <ComboBox fx:id="cbMarca" promptText="Marca" styleClass="filter-combo"/>
                <ComboBox fx:id="cbCategoria" promptText="Categoría" styleClass="filter-combo"/>
                <ComboBox fx:id="cbModelo" promptText="Modelo" styleClass="filter-combo"/>
            </HBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="PRODUCTOS DISPONIBLES" styleClass="metric-label"/>
                        <TableView fx:id="tblProductos" styleClass="table-view" VBox.vgrow="ALWAYS" prefHeight="350">
                            <columns>
                                <TableColumn prefWidth="250" text="Producto"/>
                                <TableColumn prefWidth="100" text="Stock"/>
                                <TableColumn prefWidth="100" text="Agregar"/>
                            </columns>
                        </TableView>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Productos Seleccionados" styleClass="metric-label"/>
                    <TableView fx:id="tblProductosSeleccionados" styleClass="table-view" VBox.vgrow="ALWAYS" prefHeight="350">
                        <columns>
                            <TableColumn prefWidth="220" text="Producto"/>
                            <TableColumn prefWidth="100" text="Cantidad"/>
                            <TableColumn prefWidth="120" text="Precio"/>
                            <TableColumn prefWidth="100" text="Eliminar"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancelar" styleClass="btn-secondary" fx:id="btnCancelar" onAction="#cerrarModal"/>
                <Button text="Registrar" styleClass="btn-secondary" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>