<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="a"
        stylesheets="@../../styles/style.css"
        prefHeight="620.0"
        prefWidth="500.0">

    <children>
        <VBox spacing="25.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">

            <padding>
                <Insets top="30" right="30" left="30" bottom="30"/>
            </padding>

            <VBox spacing="10">
                <Label fx:id="lblTitulo" text="Productos" styleClass="header-title"/>
                <Label text="Selecciona el producto y agregalo" styleClass="header-subtitle"/>
            </VBox>

            <VBox spacing="20">
                <VBox spacing = "6">
                    <Label text="Proveedor"/>
                    <ComboBox fx:id="" promptText="Seleccione un proveedor"/>
                </VBox>
                <ComboBox promptText="Marca" styleClass="filter-combo"/>
                <ComboBox promptText="Categoría" styleClass="filter-combo"/>
                <ComboBox promptText="Modelo" styleClass="filter-combo"/>
            </VBox>

            <VBox>
                <Label text="Productos"/>
                <VBox>
                    <TableView fx:id="" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="80" text="Producto"/>
                            <TableColumn prefWidth="80" text=""/> <!-- En esta columna irá el icono de tacho para Agregar -->
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
            <VBox>
                <Label text="Productos Seleccionados"/>
                <VBox>
                    <TableView fx:id="" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="80" text="Producto"/>
                            <TableColumn prefWidth="80" text=""/> <!-- En esta columna irá el icono de tacho para eliminar -->
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <HBox spacing="12">
                <Button text="Cancelar" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" fx:id="btnCancelar" onAction="#cerrarModal"/>
                <Button text="Registrar" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>