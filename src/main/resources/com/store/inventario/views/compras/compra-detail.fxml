<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="980.0" styleClass="root" stylesheets="@../../styles/style.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.inventario.controller.compra.CompraDetailController">

    <VBox spacing="20.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="24" left="24" right="24" top="24"/>
        </padding>

        <VBox spacing="6">
            <Label styleClass="header-title" text="Detalle de Compra"/>
            <Label styleClass="header-subtitle"
                   text="Consulta la información detallada y los productos asociados a esta transacción"/>
        </VBox>

        <!-- Tarjetas de Información General -->
        <HBox spacing="16">
            <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label styleClass="metric-label" text="CÓDIGO DE COMPRA"/>
                <Label fx:id="lblCodigoCompra" styleClass="metric-value" text="---" style="-fx-font-size: 16px;"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label styleClass="metric-label" text="FECHA Y HORA"/>
                <Label fx:id="lblFecha" styleClass="metric-value" text="---" style="-fx-font-size: 14px;"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label styleClass="metric-label" text="PROVEEDOR"/>
                <Label fx:id="lblProveedor" styleClass="metric-value" text="---" style="-fx-font-size: 14px;"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label styleClass="metric-label" text="RESPONSABLE"/>
                <Label fx:id="lblResponsable" styleClass="metric-value" text="---" style="-fx-font-size: 14px;"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label styleClass="metric-label" text="Productos Adquiridos" style="-fx-text-fill: #1E293B;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblItemsCount" styleClass="header-subtitle" text="Items: 0" style="-fx-font-weight: bold;"/>
        </HBox>

        <!-- Tabla de Productos -->
        <TableView fx:id="tblDetalleCompra" prefHeight="250.0" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colProducto" prefWidth="450.0" text="Producto"/>
                <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad"/>
                <TableColumn fx:id="colPrecio" prefWidth="180.0" text="Precio Unitario"/>
                <TableColumn fx:id="colSubtotal" prefWidth="180.0" text="Subtotal"/>
            </columns>
        </TableView>

        <!-- Sección de Totales -->
        <HBox alignment="CENTER_RIGHT" spacing="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 16px 24px;">
            <VBox spacing="4.0" alignment="CENTER_RIGHT">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="SUBTOTAL COMPRA"/>
                <Label fx:id="lblSubtotal" style="-fx-text-fill: #0F172A; -fx-font-size: 15px; -fx-font-weight: bold;" text="S/ 0.00"/>
            </VBox>
            
            <Separator orientation="VERTICAL" style="-fx-opacity: 0.5;"/>
            
            <VBox spacing="4.0" alignment="CENTER_RIGHT">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="IMPUESTOS (IGV 18%)"/>
                <Label fx:id="lblImpuesto" style="-fx-text-fill: #0F172A; -fx-font-size: 15px; -fx-font-weight: bold;" text="S/ 0.00"/>
            </VBox>
            
            <Separator orientation="VERTICAL" style="-fx-opacity: 0.5;"/>
            
            <VBox spacing="4.0" alignment="CENTER_RIGHT">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="TOTAL COMPRA"/>
                <Label fx:id="lblTotal" style="-fx-text-fill: #2563EB; -fx-font-size: 24px; -fx-font-weight: bold;" text="S/ 0.00"/>
            </VBox>
        </HBox>
 
        <!-- Botones de Acción -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Button fx:id="btnCerrar" onAction="#cerrarModal" styleClass="btn-primary" text="Cerrar" prefWidth="120.0"/>
        </HBox>
    </VBox>
</AnchorPane>
