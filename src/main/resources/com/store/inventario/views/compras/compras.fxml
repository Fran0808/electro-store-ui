<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" styleClass="root" stylesheets="@../../styles/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.compra.CompraController">

    <children>
        <VBox spacing="24.0" styleClass="view-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <VBox spacing="5">
                <Label styleClass="header-title" text="Gestión de Compras" />
                <Label styleClass="header-subtitle" text="Administración de compras e ingreso de productos al inventario" />
            </VBox>

            <HBox spacing="16" styleClass="metrics-container">
                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="Compras semanales" />
                    <Label styleClass="metric-value" text="---" />
                </VBox>

                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="Productos ingresados mensuales" />
                    <Label styleClass="metric-value" text="---" />
                </VBox>

                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="Proveedor frecuente" />
                    <Label styleClass="metric-value" text="Empresa X S.A." />
                    <Label styleClass="header-subtitle" text="x compras realizadas" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                <TextField fx:id="txtBuscarCompra" promptText="Buscar por código de compra, proveedor..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cbFecha" promptText="Fecha" styleClass="filter-combo" />
                <ComboBox fx:id="cbProveedor" promptText="Proveedor" styleClass="filter-combo" />
                <ComboBox fx:id="cbUsuario" promptText="Usuario" styleClass="filter-combo" />
                <Button onAction="#abrirModalNuevaCompra" styleClass="btn-primary" text="Nueva Compra" />
            </HBox>

            <VBox spacing="16.0" VBox.vgrow="ALWAYS">

                <TableView fx:id="tblCompras" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="69.0" text="Código" />
                        <TableColumn prefWidth="193.0" text="Proveedor" />
                        <TableColumn prefWidth="194.0" text="Usuario" />
                        <TableColumn prefWidth="128.0" text="Fecha" />
                        <TableColumn prefWidth="86.0" text="Cantidad" />
                        <TableColumn prefWidth="113.0" text="Total" />
                        <TableColumn prefWidth="196.0" text="Acciones" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="pagination-container">
                    <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Mostrando 1-10 de ** compras" HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Button fx:id="btnAnterior" styleClass="btn-secondary" text="Anterior" />
                        <Button fx:id="btnSiguiente" styleClass="btn-secondary" text="Siguiente" />
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </children>

</AnchorPane>
