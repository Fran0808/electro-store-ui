<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>


<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.guias.GuiasController" prefHeight="800.0" prefWidth="1040.0">
    <stylesheets>
        <URL value="@../../styles/style.css" />
    </stylesheets>
    <VBox styleClass="view-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" spacing="20">

        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="4">
                <Label styleClass="header-title" text="Guías de Inventario" />
                <Label styleClass="header-subtitle" text="Gestión de ajustes manuales de stock" />
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="12" HBox.hgrow="ALWAYS">
                <Button fx:id="btnExportar" styleClass="btn-secondary" text="Exportar" />
                <Button fx:id="btnNuevaGuia" styleClass="btn-primary" text="Nueva Guía" onAction="#handleNuevaGuia"/>
            </HBox>
        </HBox>

        <HBox alignment="CENTER" spacing="12" styleClass="search-container">
            <TextField fx:id="txtBuscar" promptText="Código o motivo..." styleClass="search-field" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cbTipo" promptText="Tipo" styleClass="filter-combo" />
            <ComboBox fx:id="cbFecha" promptText="Fecha" styleClass="filter-combo">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Todos" />
                        <String fx:value="Hoy" />
                        <String fx:value="Últimos 7 días" />
                        <String fx:value="Últimos 30 días" />
                        <String fx:value="Este mes" />
                    </FXCollections>
                </items>
            </ComboBox>
            <Button fx:id="btnLimpiar" styleClass="btn-secondary" text="Limpiar" />
            <Button fx:id="btnBuscar" styleClass="btn-primary" text="Buscar" />
        </HBox>

        <TableView fx:id="tblGuias" VBox.vgrow="ALWAYS" styleClass="products-table">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="100" />
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="130" />
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="80" />
                <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="180" />
                <TableColumn fx:id="colProductos" text="Productos" prefWidth="90" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colUnidades" text="Total Unidades" prefWidth="110" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="120" />
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140" style="-fx-alignment: CENTER;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="pagination-container">
            <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Cargando guías..." HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button fx:id="btnAnterior" styleClass="btn-secondary" text="Anterior" />
                <Button fx:id="btnSiguiente" styleClass="btn-secondary" text="Siguiente" />
            </HBox>
        </HBox>
    </VBox>
</AnchorPane>
