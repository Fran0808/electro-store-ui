<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" styleClass="root" stylesheets="@../../styles/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.empleados.EmpleadosController">

    <children>

        <VBox spacing="24.0" styleClass="view-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <VBox spacing="5">
                <Label styleClass="header-title" text="Control de Empleados" />
                <Label styleClass="header-subtitle" text="Seguimiento y control de empleados registrados" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                <TextField promptText="Buscar por nombre, DNI..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-primary" text="Nuevo Empleado" onAction="#abrirModalNuevoEmpleado" />
            </HBox>

            <VBox spacing="16" VBox.vgrow="ALWAYS">
                <TableView fx:id="tblView" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="80" text="Código" />
                        <TableColumn prefWidth="246.0" text="Nombre" />
                        <TableColumn prefWidth="144.0" text="DNI" />
                        <TableColumn prefWidth="163.0" text="Cargo" />
                        <TableColumn prefWidth="141.0" text="Teléfono" />
                        <TableColumn prefWidth="205.0" text="Acciones" />
                    </columns>

                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="pagination-container">
                    <Label styleClass="pagination-summary" text="Mostrando 1 a 5 de ** registros" />
                    <Button styleClass="btn-secondary" text="Anterior" />
                    <Button styleClass="btn-secondary" text="1" />
                    <Button styleClass="btn-secondary" text="2" />
                    <Button styleClass="btn-secondary" text="3" />
                    <Button styleClass="btn-secondary" text="Siguiente" />
                </HBox>
            </VBox>

        </VBox>

    </children>


</AnchorPane>
