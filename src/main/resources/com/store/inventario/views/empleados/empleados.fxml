<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" styleClass="root" stylesheets="@../../styles/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.empleados.EmpleadosController">

    <children>

        <VBox spacing="24.0" styleClass="view-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <VBox spacing="5">
                <Label styleClass="header-title" text="Control de Empleados" />
                <Label styleClass="header-subtitle" text="Seguimiento y control de empleados registrados" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, DNI..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnLimpiar" styleClass="btn-secondary" text="Limpiar" />
                <Button fx:id="btnBuscar" styleClass="btn-primary" text="Buscar" />
                <Button onAction="#abrirModalNuevoEmpleado" styleClass="btn-primary" text="Nuevo Empleado" />
            </HBox>

            <VBox spacing="16" VBox.vgrow="ALWAYS">
                <TableView fx:id="tblView" minHeight="150.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="180.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombres" />
                        <TableColumn fx:id="colApellido" prefWidth="140.0" text="Apellidos" />
                        <TableColumn fx:id="colTelefono" prefWidth="150.0" text="Teléfono" />
                        <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                        <TableColumn fx:id="colCargo" prefWidth="120.0" text="Cargo" />
                        <TableColumn fx:id="colSueldo" prefWidth="100.0" text="Sueldo" />
                        <TableColumn fx:id="colAcciones" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="pagination-container">
                    <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Mostrando 1-10 de 50 empleados" HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Button fx:id="btnAnterior" styleClass="btn-secondary" text="Anterior" />
                        <Button fx:id="btnSiguiente" styleClass="btn-secondary" text="Siguiente" />
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
