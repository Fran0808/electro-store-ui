<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" stylesheets="@proveedor-style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">

   <children>

      <VBox spacing="25.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>

         <VBox spacing="5">
            <Label styleClass="page-title" text="Gestión de Proveedores" />
            <Label styleClass="page-subtitle" text="Administra los proveedores vinculados al sistema" />
         </VBox>

         <HBox spacing="20">
            <VBox maxWidth="Infinity" spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
               <Label styleClass="card-title" text="Total de proveedores" />
               <Label styleClass="card-value" text="---" />
            </VBox>

            <VBox maxWidth="Infinity" spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
               <Label styleClass="card-title" text="Compras mensuales" />
               <Label styleClass="card-value" text="---" />
            </VBox>

            <VBox maxWidth="Infinity" spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
               <Label styleClass="card-title" text="Último registrado" />
               <Label styleClass="card-value" text="Empresa X S.A." />
               <Label styleClass="card-subtitle" text="Hace 2 horas" />
            </VBox>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="15">
            <TextField promptText="Buscar por nombre, RUC..." styleClass="search-input" HBox.hgrow="ALWAYS" />
            <Button styleClass="proveedor-button" text="+ Nuevo Proveedor" />
         </HBox>

         <VBox spacing="20.0" VBox.vgrow="ALWAYS">

               <TableView fx:id="tableView" styleClass="design-table" VBox.vgrow="ALWAYS">
                  <columns>
                     <TableColumn prefWidth="80" text="Código" />
                     <TableColumn prefWidth="220" text="Nombre Comercial" />
                     <TableColumn prefWidth="180" text="Razón Social" />
                     <TableColumn prefWidth="220" text="RUC" />
                     <TableColumn prefWidth="121.0" text="Teléfono" />
                     <TableColumn prefWidth="126.0" text="Acciones" />
                  </columns>

               </TableView>

               <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="pagination-container">
                  <Label text="Mostrando 1 a 5 de ** registros" />
                  <Button styleClass="pagination-button" text="Anterior" />
                  <Button styleClass="pagination-button" text="1" />
                  <Button styleClass="pagination-button" text="2" />
                  <Button styleClass="pagination-button" text="3" />
                  <Button styleClass="pagination-button" text="Siguiente" />
               </HBox>
         </VBox>

      </VBox>

   </children>
</AnchorPane>
