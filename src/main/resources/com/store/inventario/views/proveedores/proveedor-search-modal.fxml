<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" styleClass="root" stylesheets="@../../styles/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.proveedor.ProveedorSearchModalController">

    <VBox spacing="16.0" style="-fx-padding: 20;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox spacing="4">
            <Label styleClass="header-title" text="Seleccionar Proveedor" style="-fx-font-size: 18px;"/>
            <Label styleClass="header-subtitle" text="Busque y seleccione el proveedor para asociarlo a esta compra" />
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="txtBuscar" onAction="#handleBuscar" promptText="Buscar por RUC, Nombre Comercial o Razón Social..." styleClass="search-field" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLimpiar" styleClass="btn-secondary" text="Limpiar" />
            <Button fx:id="btnBuscar" onAction="#handleBuscar" styleClass="btn-primary" text="Buscar" />
        </HBox>

        <TableView fx:id="tblProveedores" styleClass="table-view" VBox.vgrow="ALWAYS" onMouseClicked="#handleTablaClicked">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombreComercial" prefWidth="200.0" text="Nombre Comercial" />
                <TableColumn fx:id="colRazonSocial" prefWidth="200.0" text="Razón Social" />
                <TableColumn fx:id="colRuc" prefWidth="120.0" text="RUC" />
                <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Cargando proveedores..." HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="6">
                <Button fx:id="btnAnterior" onAction="#handlePaginaAnterior" styleClass="btn-secondary" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handlePaginaSiguiente" styleClass="btn-secondary" text="Siguiente" />
            </HBox>
        </HBox>

        <Separator />

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button fx:id="btnCancelar" onAction="#handleCancelar" styleClass="btn-secondary" text="Cancelar" />
            <Button fx:id="btnSeleccionar" onAction="#handleSeleccionar" styleClass="btn-primary" text="Seleccionar" />
        </HBox>

    </VBox>

</AnchorPane>
