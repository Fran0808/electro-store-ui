<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" styleClass="root" stylesheets="@../../styles/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">

    <children>

        <VBox spacing="24.0" styleClass="view-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <VBox spacing="5">
                <Label styleClass="header-title" text="Control de Clientes" />
                <Label styleClass="header-subtitle" text="Supervisión, seguimiento y control detallado de clientes registrados en el sistema" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                <TextField promptText="Buscar por DNI..." styleClass="search-field" HBox.hgrow="ALWAYS" />
            </HBox>

            <VBox spacing="16.0" VBox.vgrow="ALWAYS">

                <TableView fx:id="tblView" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="80" text="Código" />
                        <TableColumn prefWidth="235.0" text="Nombre" />
                        <TableColumn prefWidth="226.0" text="DNI" />
                        <TableColumn prefWidth="231.0" text="RUC" />
                        <TableColumn prefWidth="207.0" text="Teléfono" />
                    </columns>

                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="pagination-container">
                    <Label styleClass="pagination-summary" text="Mostrando 1 a 5 de ** registros" />
                    <Button styleClass="btn-secondary" text="Anterior" />
                    <Button styleClass="btn-secondary" text="1" />
                    <Button styleClass="btn-secondary" text="2" />
                    <Button styleClass="btn-secondary" text="3" />
                    <Button styleClass="btn-secondary" text="Siguiente" />
                </HBox>
            </VBox>

        </VBox>

    </children>

</AnchorPane>
