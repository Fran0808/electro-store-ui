<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="820.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.inventario.controller.ventas.VentaFormController">
    <stylesheets>
        <URL value="@../../styles/style.css"/>
        <URL value="@ventas.css"/>
    </stylesheets>
    <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
        </padding>
        <VBox spacing="4.0">
            <Label styleClass="header-title" text="Registrar Nueva Venta"/>
            <Label styleClass="header-subtitle"
                   text="Complete los datos de la transacción y agregue los productos vendidos"/>
        </VBox>

        <HBox spacing="30.0">
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <VBox spacing="6.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;"
                           text="Código de Venta"/>
                    <TextField fx:id="txtCodigoVenta" editable="false" prefHeight="40.0"
                               styleClass="search-field"
                               style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-background-radius: 6px;"
                               VBox.vgrow="NEVER"/>
                </VBox>
                <VBox spacing="6.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;"
                           text="Cliente"/>
                    <TextField fx:id="cbCliente" editable="false" prefHeight="40.0" prefWidth="320.0"
                               styleClass="search-field"
                               style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-background-radius: 6px;"
                               VBox.vgrow="NEVER"/>
                </VBox>
            </VBox>
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <VBox spacing="6.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;"
                           text="Vendedor"/>
                    <TextField fx:id="txtVendedor" editable="false" prefHeight="40.0"
                               styleClass="search-field"
                               style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-background-radius: 6px;"
                               VBox.vgrow="NEVER"/>
                </VBox>
                <VBox spacing="6.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;"
                           text="Buscar cliente"/>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <TextField fx:id="txtClienteBuscar" editable="false" prefHeight="40.0"
                                   HBox.hgrow="ALWAYS" styleClass="search-field"
                                   style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-background-radius: 6px;"/>
                        <Button fx:id="btnBuscarCliente" prefHeight="40.0" text="Buscar"
                                styleClass="btn-primary"/>
                    </HBox>
                </VBox>
                <DatePicker fx:id="dpFechaVenta" visible="false" managed="false"/>
            </VBox>
        </HBox>

        <Separator style="-fx-padding: 4 0 4 0;"/>

        <VBox spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 15px;"
                   text="Detalle de Productos"/>
            <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Buscar Producto"/>
                    <TextField fx:id="cbProducto" editable="false" prefHeight="40.0"
                               styleClass="search-field"
                               style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-background-radius: 6px;"/>
                </VBox>
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Cantidad"/>
                    <Spinner fx:id="spnCantidad" prefHeight="40.0" prefWidth="100.0"/>
                </VBox>
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Precio Unitario"/>
                    <TextField fx:id="txtPrecioUnitario" prefHeight="40.0" prefWidth="130.0"
                               promptText="0.00" styleClass="search-field"/>
                </VBox>
                <Button fx:id="btnAgregarProducto" onAction="#handleAgregarProducto" prefHeight="40.0"
                        styleClass="btn-primary" text="Agregar"/>
            </HBox>
        </VBox>

        <TableView fx:id="tblDetalleVenta" prefHeight="200.0" styleClass="sales-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDetCodigo" prefWidth="100.0" text="Código"/>
                <TableColumn fx:id="colDetProducto" prefWidth="240.0" text="Producto"/>
                <TableColumn fx:id="colDetPrecio" prefWidth="120.0" text="Precio Unit."/>
                <TableColumn fx:id="colDetCantidad" prefWidth="100.0" text="Cantidad"/>
                <TableColumn fx:id="colDetSubtotal" prefWidth="120.0" text="Subtotal"/>
                <TableColumn fx:id="colDetAcciones" style="-fx-alignment: CENTER;" text="Quitar"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-padding: 6 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 15px;"
                       text="Total:"/>
                <Label fx:id="lblTotalVenta"
                       style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 20px;"
                       text="S/"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancelar" onAction="#handleCancelar" prefWidth="120.0" styleClass="btn-secondary"
                    text="Cancelar"/>
            <Button fx:id="btnRegistrarVenta" onAction="#handleRegistrarVenta" prefWidth="160.0"
                    styleClass="btn-primary" text="Registrar Venta"/>
        </HBox>
    </VBox>
</AnchorPane>
