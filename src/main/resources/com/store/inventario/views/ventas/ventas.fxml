<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" styleClass="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.store.inventario.controller.ventas.VentaController">

    <stylesheets>
        <URL value="@../../styles/style.css" />
        <URL value="@ventas.css" />
    </stylesheets>

    <VBox styleClass="view-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="header-title" text="Historial de Ventas" />
                <Label styleClass="header-subtitle" text="Visualiza, analiza y gestiona las transacciones comerciales del sistema." />
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="btnNuevaVenta" styleClass="btn-primary" text="Nueva Venta" onAction="#abrirModalNuevaVenta" />
            </HBox>
        </HBox>

        <VBox fx:id="containerContenido" spacing="24" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER" spacing="16">
                <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="metric-icon-container, icon-blue">
                        <SVGPath content="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" styleClass="metric-icon" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="metric-label" text="Ventas de Hoy" />
                        <Label fx:id="lblVendidoHoy" styleClass="metric-value" text="S/ 4,820.00" />
                    </VBox>
                </HBox>

                <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="metric-icon-container, icon-orange">
                        <SVGPath content="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8" styleClass="metric-icon" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="metric-label" text="Transacciones" />
                        <Label fx:id="lblTotalTransacciones" styleClass="metric-value" text="38" />
                    </VBox>
                </HBox>

                <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="metric-icon-container, icon-purple">
                        <SVGPath content="M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6" styleClass="metric-icon" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="metric-label" text="Ticket Promedio" />
                        <Label fx:id="lblTicketPromedio" styleClass="metric-value" text="S/ 126.84" />
                    </VBox>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                <TextField fx:id="txtBuscarVenta" HBox.hgrow="ALWAYS" promptText="Buscar ventas por cliente o código..." styleClass="search-field" onAction="#ejecutarBusqueda"/>
                <ComboBox fx:id="cbVendedor" promptText="Vendedor" styleClass="filter-combo"/>
                <ComboBox fx:id="cbRangoFecha" promptText="Fecha" styleClass="filter-combo"/>
                <Button fx:id="btnLimpiarVenta" styleClass="btn-secondary" text="Limpiar" onAction="#limpiarFiltros"/>
                <Button onAction="#ejecutarBusqueda" styleClass="btn-primary" text="Buscar"/>
            </HBox>

            <TableView fx:id="tblVentas" styleClass="sales-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="160.0" text="Código" />
                    <TableColumn fx:id="colFecha" prefWidth="140.0" text="Fecha y Hora" />
                    <TableColumn fx:id="colCliente" prefWidth="220.0" text="Cliente" />
                    <TableColumn fx:id="colVendedor" prefWidth="180.0" text="Vendedor" />
                    <TableColumn fx:id="colArticulos" prefWidth="100.0" text="Artículos" />
                    <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total" />
                    <TableColumn fx:id="colAcciones" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Acciones" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="pagination-container">
                <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Cargando ventas..." HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button fx:id="btnAnterior" styleClass="btn-secondary" text="Anterior" onAction="#handlePaginaAnterior" />
                    <Button fx:id="btnSiguiente" styleClass="btn-secondary" text="Siguiente" onAction="#handlePaginaSiguiente" />
                </HBox>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
