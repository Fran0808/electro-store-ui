<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="800.0" prefWidth="1040.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../../styles/style.css" />
        <URL value="@productos.css" />
    </stylesheets>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox styleClass="view-container">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="header-title" text="Gestión de Productos" />
                        <Label styleClass="header-subtitle" text="Administra y controla el inventario de electrodomésticos del sistema." />
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button fx:id="btnActualizar" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnNuevoProducto" styleClass="btn-primary" text="Nuevo Producto" />
                    </HBox>
                </HBox>

                <HBox alignment="CENTER" spacing="16">
                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-blue">
                            <SVGPath content="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96L12 12.01l8.73-5.05 M12 22.08V12" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Total Productos" />
                            <Label fx:id="lblTotalProductos" styleClass="metric-value" text="1,284" />
                        </VBox>
                    </HBox>

                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-orange">
                            <SVGPath content="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Stock Bajo" />
                            <Label fx:id="lblStockBajo" styleClass="metric-value" text="42" />
                        </VBox>
                    </HBox>

                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-red">
                            <SVGPath content="M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10z M15 9l-6 6 M9 9l6 6" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Agotados" />
                            <Label fx:id="lblAgotados" styleClass="metric-value" text="15" />
                        </VBox>
                    </HBox>

                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-purple">
                            <SVGPath content="M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Categorías" />
                            <Label fx:id="lblCategorias" styleClass="metric-value" text="18" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Barra de Búsqueda y Filtros -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                    <TextField fx:id="txtBuscar" HBox.hgrow="ALWAYS" promptText="Buscar productos por nombre, SKU o marca..." styleClass="search-field" />
                    <ComboBox fx:id="cbCategoria" promptText="Categoría" styleClass="filter-combo" />
                    <ComboBox fx:id="cbMarca" promptText="Marca" styleClass="filter-combo" />
                    <ComboBox fx:id="cbEstado" promptText="Estado" styleClass="filter-combo" />
                    <Button fx:id="btnLimpiar" styleClass="btn-secondary" text="Limpiar" />
                    <Button fx:id="btnBuscar" styleClass="btn-primary" text="Buscar" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
