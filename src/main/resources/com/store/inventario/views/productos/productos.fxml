<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="600.0" prefWidth="1040.0" styleClass="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.controller.productos.ProductoController">

    <stylesheets>
        <URL value="@../../styles/style.css" />
    </stylesheets>

    <VBox styleClass="view-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="header-title" text="Gestión de Productos" />
                        <Label styleClass="header-subtitle" text="Administra y controla el inventario de electrodomésticos del sistema." />
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button fx:id="btnActualizar" onAction="#handleActualizar" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnGestionarCategorias" onAction="#handleGestionarCategorias" styleClass="btn-secondary" text="Categorías" />
                        <Button fx:id="btnNuevoProducto" styleClass="btn-primary" text="Nuevo Producto" onAction="#handleForm"/>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER" spacing="16">
                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-blue">
                            <SVGPath content="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96L12 12.01l8.73-5.05 M12 22.08V12" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Total Productos" />
                            <Label fx:id="lblTotalProductos" styleClass="metric-value" text="---" />
                        </VBox>
                    </HBox>

                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-orange">
                            <SVGPath content="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Stock Bajo" />
                            <Label fx:id="lblStockBajo" styleClass="metric-value" text="---" />
                        </VBox>
                    </HBox>

                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-red">
                            <SVGPath content="M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10z M15 9l-6 6 M9 9l6 6" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Agotados" />
                            <Label fx:id="lblAgotados" styleClass="metric-value" text="---" />
                        </VBox>
                    </HBox>

                    <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="metric-icon-container, icon-purple">
                            <SVGPath content="M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z" styleClass="metric-icon" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="metric-label" text="Categorías" />
                            <Label fx:id="lblCategorias" styleClass="metric-value" text="---" />
                        </VBox>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-container">
                    <TextField fx:id="txtBuscar" onAction="#ejecutarBusqueda" HBox.hgrow="ALWAYS" promptText="Buscar productos por nombre, SKU o marca..." styleClass="search-field" />
                    <ComboBox fx:id="cbCategoria" onAction="#ejecutarBusqueda" promptText="Categoría" styleClass="filter-combo" />
                    <ComboBox fx:id="cbMarca" onAction="#ejecutarBusqueda" promptText="Marca" styleClass="filter-combo" />
                    <ComboBox fx:id="cbEstado" onAction="#ejecutarBusqueda" promptText="Estado" styleClass="filter-combo" />
                    <Button fx:id="btnLimpiar" onAction="#limpiarBusqueda" styleClass="btn-secondary" text="Limpiar" />
                    <Button fx:id="btnBuscar" onAction="#ejecutarBusqueda" styleClass="btn-primary" text="Buscar" />
                </HBox>

                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" minHeight="150.0" styleClass="products-table">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="230.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre del Producto" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                        <TableColumn fx:id="colMarca" prefWidth="120.0" text="Marca" />
                        <TableColumn fx:id="colModelo" prefWidth="120.0" text="Modelo" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                        <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
                        <TableColumn fx:id="colGarantia" prefWidth="100.0" text="Garantía" />
                        <TableColumn fx:id="colAcciones" prefWidth="120.0" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="pagination-container">
                    <Label fx:id="lblResumenPaginacion" maxWidth="Infinity" styleClass="pagination-summary" text="Cargando productos..." HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Button fx:id="btnAnterior" onAction="#handlePaginaAnterior" styleClass="btn-secondary" text="Anterior" />
                        <Button fx:id="btnSiguiente" onAction="#handlePaginaSiguiente" styleClass="btn-secondary" text="Siguiente" />
                    </HBox>
                </HBox>
            </VBox>
</AnchorPane>
