<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../styles/table-global-style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>

       <VBox spacing="20.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <TableView fx:id="tableView" styleClass="design-table" VBox.vgrow="ALWAYS" />

           <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="pagination-container">
               <Label text="Mostrando 1 a 5 de ** registros" />
               <Button styleClass="pagination-button" text="Anterior" />
               <Button styleClass="pagination-button" text="1" />
               <Button styleClass="pagination-button" text="2" />
               <Button styleClass="pagination-button" text="3" />
               <Button styleClass="pagination-button" text="Siguiente" />
           </HBox>

      </VBox>
   </children>
</AnchorPane>
