<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="750.0" prefWidth="1150.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.inventario.module.movement.controller.GuideDetailFormController">
    <stylesheets>
        <URL value="@../../styles/style.css" />
    </stylesheets>
    <children>
        <VBox spacing="16.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20"/>
            </padding>

            <VBox spacing="4">
                <Label styleClass="header-title" text="Nueva Guía de Inventario" />
                <Label styleClass="header-subtitle" text="Gestione la guía agregando productos desde el catálogo e ingresando los datos correspondientes" />
            </VBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                <VBox prefWidth="480.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <Label styleClass="metric-label" text="1. CATÁLOGO DE PRODUCTOS" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                    
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <TextField fx:id="txtBuscarProducto" onAction="#handleBuscarProducto" promptText="Buscar por nombre o código..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBuscarProducto" styleClass="btn-secondary" text="Buscar" prefHeight="36.0"/>
                    </HBox>

                    <TableView fx:id="tblCatalogo" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colCatCod" prefWidth="110.0" text="Código" />
                            <TableColumn fx:id="colCatProducto" prefWidth="250.0" text="Producto" />
                            <TableColumn fx:id="colCatStock" prefWidth="90.0" text="Stock" />
                        </columns>
                    </TableView>

                    <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;">
                        <Label fx:id="lblProductoSeleccionado" text="Seleccione un producto del catálogo..." style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                            <!-- Stock actual -->
                            <VBox spacing="4" prefWidth="100.0">
                                <Label styleClass="header-subtitle" text="Stock ref." style="-fx-font-size: 10px;"/>
                                <TextField fx:id="txtStockActual" editable="false" styleClass="disabled-field" prefHeight="36.0"/>
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="header-subtitle" text="Cantidad *" style="-fx-font-size: 10px;"/>
                                <TextField fx:id="txtCantidad" onAction="#handleAgregarProducto" promptText="0" styleClass="search-field" prefHeight="36.0"/>
                            </VBox>

                            <Button fx:id="btnAgregarProducto" onAction="#handleAgregarProducto" styleClass="btn-primary" text="Añadir" prefHeight="36.0" prefWidth="100.0" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <Label styleClass="metric-label" text="2. INFORMACIÓN Y DETALLE DE LA GUÍA" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>

                    <HBox spacing="16.0">
                        <VBox minWidth="180.0" prefWidth="180.0" spacing="4.0">
                            <Label styleClass="header-subtitle" text="Tipo de Movimiento *"/>
                            <HBox spacing="15.0" alignment="CENTER_LEFT" prefHeight="36.0">
                                <RadioButton fx:id="rbEntry" text="Entrada">
                                    <toggleGroup>
                                       <ToggleGroup fx:id="tipoGroup" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="rbExit" text="Salida" toggleGroup="$tipoGroup" />
                            </HBox>
                        </VBox>

                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="header-subtitle" text="Motivo del Ajuste *"/>
                            <TextField fx:id="txtMotivo" prefHeight="36.0" promptText="Ej: Conteo físico, Merma..." />
                        </VBox>

                        <VBox spacing="4.0" prefWidth="160.0">
                            <Label styleClass="header-subtitle" text="Responsable"/>
                            <TextField fx:id="txtUsuario" editable="false" prefHeight="36.0" styleClass="disabled-field" />
                        </VBox>
                    </HBox>

                    <VBox spacing="4.0">
                        <Label styleClass="header-subtitle" text="Descripción / Observaciones (opcional)" />
                        <TextField fx:id="txtDescripcion" prefHeight="36.0" promptText="Detalles adicionales del ajuste..." />
                    </VBox>

                    <Separator />

                    <!-- Tabla de Detalle -->
                    <TableView fx:id="tblDetalle" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colCod" prefWidth="110.0" text="Código" />
                            <TableColumn fx:id="colProducto" prefWidth="250.0" text="Producto" />
                            <TableColumn fx:id="colStockActual" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Stock Actual" />
                            <TableColumn fx:id="colCantidad" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Cantidad" />
                            <TableColumn fx:id="colAcciones" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Acción" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="40.0" style="-fx-padding: 8; -fx-border-width: 1 0 0 0; -fx-border-color: #ddd;">
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Total productos:" />
                            <Label fx:id="lblTotalProductos" style="-fx-font-size:16px; -fx-font-weight:bold;" text="0" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <Label style="-fx-font-size:11px; -fx-text-fill:#666;" text="Total unidades:" />
                            <Label fx:id="lblTotalUnidades" style="-fx-font-size:16px; -fx-font-weight:bold;" text="0" />
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button fx:id="btnCancelar" onAction="#handleCancelar" styleClass="btn-secondary" text="Cancelar" />
                <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="btn-primary" text="Guardar Guía" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
