<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="750.0" prefWidth="1150.0" styleClass="root" stylesheets="@../../styles/style.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.inventario.module.buy.controller.PurchaseFormController">

    <VBox spacing="16.0" styleClass="modal-container" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
        </padding>

        <!-- Cabecera Principal -->
        <VBox spacing="4">
            <Label fx:id="lblTitulo" styleClass="header-title" text="Registrar Nueva Compra"/>
            <Label styleClass="header-subtitle" text="Gestione la compra agregando productos desde el catálogo e ingresando los datos correspondientes"/>
        </VBox>

        <!-- Contenedor Principal Lado a Lado -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- Panel Izquierdo: Catálogo de Productos -->
            <VBox prefWidth="480.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                <Label styleClass="metric-label" text="1. CATÁLOGO DE PRODUCTOS" style="-fx-text-fill: #1E293B;"/>
                
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarProducto" promptText="Buscar por nombre, código o marca..." styleClass="search-field" HBox.hgrow="ALWAYS" onAction="#ejecutarBusquedaLocal"/>
                    <Button onAction="#ejecutarBusquedaLocal" styleClass="btn-secondary" text="Buscar"/>
                </HBox>

                <TableView fx:id="tblProductos" prefHeight="300.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn prefWidth="100.0" text="Código" fx:id="colCatCodigo"/>
                        <TableColumn prefWidth="240.0" text="Producto" fx:id="colCatNombre"/>
                        <TableColumn prefWidth="90.0" text="Stock" fx:id="colCatStock"/>
                    </columns>
                </TableView>

                <!-- Configuración de Producto Seleccionado -->
                <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="lblProductoSeleccionado" text="Seleccione un producto del catálogo..." style="-fx-font-weight: bold; -fx-text-fill: #475569;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 2 0;">
                        <Label fx:id="lblPrecioVentaRef" text="" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                        <Label fx:id="lblMargenRef" text="" style="-fx-text-fill: #0D9488; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>
                    
                    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="header-subtitle" text="Precio Unitario (S/)"/>
                            <TextField fx:id="txtPrecioCompra" promptText="S/ 0.00" styleClass="search-field"/>
                        </VBox>

                        <VBox spacing="4" prefWidth="110.0">
                            <Label styleClass="header-subtitle" text="Cantidad"/>
                            <TextField fx:id="txtCantidad" promptText="Cant." styleClass="search-field"/>
                        </VBox>

                        <Button onAction="#agregarProductoALaLista" styleClass="btn-primary" text="Añadir" prefHeight="38.0"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Panel Derecho: Datos de la Compra y Detalle -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                <Label styleClass="metric-label" text="2. INFORMACIÓN Y DETALLE DE COMPRA" style="-fx-text-fill: #1E293B;"/>

                <!-- Datos de Cabecera -->
                <HBox spacing="12.0">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="header-subtitle" text="Proveedor *"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <TextField fx:id="txtProveedor" editable="false" promptText="Seleccione un proveedor..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnBuscarProveedor" onAction="#abrirBuscadorProveedor" styleClass="btn-primary" text="Buscar"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="4" prefWidth="160.0">
                        <Label styleClass="header-subtitle" text="Responsable"/>
                        <TextField fx:id="txtUsuario" editable="false" styleClass="search-field" text="Cargando..."/>
                    </VBox>

                    <VBox spacing="4" prefWidth="130.0">
                        <Label styleClass="header-subtitle" text="Fecha de operación"/>
                        <TextField fx:id="txtFecha" editable="false" styleClass="search-field" text="Cargando..."/>
                    </VBox>
                </HBox>

                <!-- Tabla de Detalle -->
                <TableView fx:id="tblDetalleCompra" prefHeight="300.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn prefWidth="220.0" text="Producto" fx:id="colProducto"/>
                        <TableColumn prefWidth="110.0" text="Precio Unit." fx:id="colPrecioCompra"/>
                        <TableColumn prefWidth="80.0" text="Cant." fx:id="colCantidad"/>
                        <TableColumn prefWidth="110.0" text="Importe" fx:id="colSubtotal"/>
                        <TableColumn prefWidth="70.0" text="Acción" fx:id="colEliminar"/>
                    </columns>
                </TableView>

                <!-- Resumen Financiero -->
                <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 8 0 0 0;">
                    <Label styleClass="metric-label" text="TOTAL COMPRA:"/>
                    <Label fx:id="lblTotal" styleClass="metric-value" text="S/ 0.00" style="-fx-font-size: 20px;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Botones de Acción Global -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button fx:id="btnCancelar" onAction="#cerrarModal" styleClass="btn-secondary" text="Cancelar"/>
            <Button onAction="#registrarCompra" styleClass="btn-primary" text="Registrar Compra"/>
        </HBox>

    </VBox>
</AnchorPane>
